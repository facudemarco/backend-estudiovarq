# systemd unit para el backend EstudioVArq (probar con: systemctl daemon-reload)
# Ajustá WorkingDirectory/EnvironmentFile a la ruta real en tu server.
# El proxy reverso (npm/nginx) ya apunta a api-estudiovarq.iwebtecnology.com -> 127.0.0.1:8000

[Unit]
Description=EstudioVArq API backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/api-estudiovarq
EnvironmentFile=/opt/api-estudiovarq/.env
ExecStart=/opt/api-estudiovarq/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target